# Required in Vercel Environment Variables

# Pinecone Assistant API key — used by ChatBot.jsx sendMessage() to query teazzers-data
VITE_PINECONE_API_KEY=your_pinecone_api_key_here

# OpenAI API key — used by ChatBot.jsx getEmbedding() to generate vectors for teazzers-history
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Pinecone history index host — set this to match your index host in Pinecone console
VITE_PINECONE_HISTORY_HOST=teazzers-history-vbgqbnq.svc.aped-4627-b74a.pinecone.io

# Vercel env var — set this to match your issues-count index host in Pinecone console
# The index must be: Dense | us-east-1 | 1536 dim | cosine metric
VITE_ISSUES_COUNT_HOST=issues-count-vbgqbnq.svc.aped-4627-b74a.pinecone.io

