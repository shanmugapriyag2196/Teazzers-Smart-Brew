# Required in Vercel Environment Variables

# Pinecone Assistant API key — used by ChatBot.jsx sendMessage() to query teazzers-data
VITE_PINECONE_API_KEY=your_pinecone_api_key_here

# OpenAI API key — used by ChatBot.jsx getEmbedding() to generate vectors for teazzers-history
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Pinecone history index host — set this to match your index host in Pinecone console
VITE_PINECONE_HISTORY_HOST=teazzers-history-vbgqbnq.svc.aped-4627-b74a.pinecone.io

# ── CRITICAL: pinecone index dimension ───────────────────────────────────
# This code uses text-embedding-3-small which embeds at 1536 dimensions.
# The teazzers-history index in your Pinecone console MUST have
#   Dimension  = 1536
#   Metric     = cosine
#   Type       = Dense
#   Region     = us-east-1
#
# Your index currently has dimension 512 (confirmed by describe_index_stats).
# Pinecone silently rejects every vector whose dimension does not match the
# index dimension, so Record count stays at 0 until you fix it.
#
# Fix (one-time, in your Pinecone console):
#   1. Delete the existing teazzers-history index (dimension 512)
#       Dimensions = 1536
#       Metric     = cosine
# Without this step the history sidebar will always say "No conversations yet".
